LLM_API_KEY=_insert_your_key_here

# Owners: 048 273 439
SUPABASE_URL=fake_supabase_url
# Owners: 048 273 439
SUPABASE_PUBLISHABLE_KEY=fake_supabase_publishable_key
# Owners: 048 273 439
SUPABASE_SECRET_KEY=fake_supabase_secret_key
# Owners: 048 273 439
SUPABASE_JWKS_URL=faeke_supabase_jwks_url

# Interview backend. No direct database password or DATABASE_URL required.
# Supabase mode requires the LOCAL-09 RPC reviewed/applied by Huy.
# Owners: 273
INTERVIEW_STORAGE=auto
# Owners: 273
INTERVIEW_LOCAL_STORAGE=0
INTERVIEW_DB_PATH=data/private/interviews.sqlite

# ---- LLM host: NVIDIA ----
# Owners: 312
NVIDIA_API_KEY=
# Owners: 312
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Owners: 312
AI_MAX_TOKENS=4096
# Owners: 312
AI_TIMEOUT_S=180
# Owners: 312
AI_TEMPERATURE=0.4

# ---- Web search tool: TinyFish (retrieval only) ----
# Owners: 312
TINYFISH_API_KEY=
# Owners: 312
TINYFISH_LIMIT=8
# Owners: 312
TINYFISH_TIMEOUT_S=60

# ---- Service behaviour ----
# Owners: 312
AI_RETRY_DELAY_S=5
# Owners: 312
AI_RESEARCH_TURNS=6
# Owners: 312
AI_MAX_TOOL_CALLS=10

# Backend Interview (269). Select nvidia only with the AI provider configured.
# auto   = real provider as soon as NVIDIA_API_KEY is set, offline mock otherwise
# mock   = offline demo provider (no key needed)
# nvidia = real questions, grades and report comments (needs NVIDIA_API_KEY,
#          plus TINYFISH_API_KEY for the self-research round)
INTERVIEW_AI_PROVIDER=auto
# Wall-clock budget per AI stage. generate_questions p95 is 28.5s with the
# self-research round, so 20s would time out into the fallback. Seam caps 1-60.
INTERVIEW_AI_TIMEOUT_S=30
# Forward the CV text to the provider. It is masked before it reaches a prompt
# (docs/ai-cv-policy.md). Set to 0 to generate from the job profile only.
INTERVIEW_ALLOW_CV_TO_AI=1

# Optional question bank (Supabase). Off by default: with 0 every session
# generates its own questions. With 1 the bank is read first for the domain
# below and generation only runs when the bank cannot supply three questions.
INTERVIEW_QUESTION_BANK=0
INTERVIEW_BANK_DOMAIN=information_technology
INTERVIEW_BANK_LIMIT=3
