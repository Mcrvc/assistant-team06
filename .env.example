LLM_API_KEY=_insert_your_key_here

SUPABASE_URL=fake_supabase_url # 048
SUPABASE_PUBLISHABLE_KEY=fake_supabase_publishable_key # 048
SUPABASE_SECRET_KEY=fake_supabase_secret_key # 048
SUPABASE_JWKS_URL=faeke_supabase_jwks_url # 048

# Interview backend. No direct database password or DATABASE_URL required.
# Supabase mode requires the LOCAL-09 RPC reviewed/applied by Huy.
INTERVIEW_STORAGE=auto
INTERVIEW_LOCAL_STORAGE=0
INTERVIEW_DB_PATH=data/private/interviews.sqlite

# mock allows independent API tests; nvidia requires Duy's modules integrated separately.
INTERVIEW_AI_PROVIDER=mock
INTERVIEW_AI_TIMEOUT_S=20
INTERVIEW_ALLOW_CV_TO_AI=0
NVIDIA_API_KEY=insert_your_key_here
NVIDIA_MODEL=insert_model_from_ai_teammate_here
