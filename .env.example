LLM_API_KEY=_insert_your_key_here

SUPABASE_URL=fake_supabase_url
SUPABASE_PUBLISHABLE_KEY=fake_supabase_publishable_key
SUPABASE_SECRET_KEY=fake_supabase_secret_key
SUPABASE_JWKS_URL=faeke_supabase_jwks_url

# Local demo only. Keep disabled on shared deployments; real Auth uses Bearer JWT.
INTERVIEW_DEMO_ENABLED=0
INTERVIEW_DB_PATH=data/private/interviews.sqlite
# Explicit local persistence while testing real sign-in; keep 0 on shared deployments.
INTERVIEW_LOCAL_STORAGE=0
# auto preserves the offline demo/local opt-in; postgres explicitly uses DATABASE_URL.
# PostgreSQL requires the reviewed LOCAL-04 schema additions; no automatic DDL.
INTERVIEW_STORAGE=auto
DATABASE_URL=insert_your_postgresql_connection_url_here

# Explicit opt-in to the team NVIDIA provider; mock remains the offline default.
INTERVIEW_AI_PROVIDER=mock
INTERVIEW_AI_TIMEOUT_S=20
INTERVIEW_ALLOW_CV_TO_AI=0
# LLM_API_KEY above is also accepted by the team's AI code.
NVIDIA_API_KEY=insert_your_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AI_RETRIES=0
AI_RETRY_DELAY_S=0
